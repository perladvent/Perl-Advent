<%flags>inherit => '/page.mhtml'</%flags>

<%method subtitle>
<%args>
$article
</%args>
<% $article->title |h %>
</%method>

<%method content>
<%args>
$article
$https
$prev => undef
$next => undef
</%args>
<%perl>
    # Promote the article's first <img> to a full-width feature banner (the same
    # image used for og:image) and remove it from the body so the lead art isn't
    # shown twice. Articles without an image simply get no banner.
    my $feature;
    my $body = eval { $article->body_html } // '';
    if ($body =~ /<img\b[^>]*\bsrc\s*=\s*["']([^"']+)["'][^>]*>/i) {
        $feature = $1;
        $body =~ s/<img\b[^>]*>//;   # drop only the first <img> tag
    }
</%perl>
% if ($feature) {
<div class="feature-image"><img src="<% $feature |h %>" alt="" /></div>
% }

<h1 class='title'><% $article->title |h %></h1>
<div class='subtitle'><% $article->topic |h %> - <% $article->date->ymd %></div>

<% $body %>

<& /credit.mhtml, article => $article , https => $https &>

<ul id="pager">
% if ($prev) {
    <li class="previous"><a title="<% $prev->title |h %>" href="<% $prev->date->ymd %>.html">Previous</a></li>
% } else {
    <li class="previous">Previous</li>
% }

% if ($next) {
    <li class="next"><a title="<% $next->title |h %>" href="<% $next->date->ymd %>.html">Next</a></li>
% } else {
    <li class="next">Next</li>
% }
</ul>
<div style="clear: both"></div>
</%method>
