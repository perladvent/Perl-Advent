<?xml version="1.0" encoding="utf-8"?>
<!-- Stands in for a calendar's atom.xml until its first door opens; see
     script/coming-soon-feed.sh. It keeps the feed id and self link advcal uses,
     so subscribers carry straight on to the real feed on December 1. Nothing in
     it depends on the build date, so pushes before then leave it unchanged. -->
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Perl Advent Calendar</title>
  <id>https://perladvent.org/@YEAR@/</id>
  <link href="https://perladvent.org/@YEAR@/atom.xml" rel="self"/>
  <link href="https://perladvent.org/@YEAR@/"/>
  <updated>@YEAR@-01-01T00:00:00Z</updated>
  <author><name>PerlAdvent Org</name></author>
  <entry>
    <title>Year @EDITION@ of The Perl Advent Calendar opens on December 1st</title>
    <link href="https://perladvent.org/@YEAR@/"/>
    <id>https://perladvent.org/@YEAR@/#coming-soon</id>
    <updated>@YEAR@-01-01T00:00:00Z</updated>
    <summary>A new Perl article every day from December 1st. Each one will appear in this feed as its door opens.</summary>
    <category term="Perl"/>
  </entry>
</feed>
